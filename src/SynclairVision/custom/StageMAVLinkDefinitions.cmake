if(NOT DEFINED DEFINITIONS_SOURCE OR NOT DEFINED XML_OUTPUT)
    message(FATAL_ERROR "DEFINITIONS_SOURCE and XML_OUTPUT are required")
endif()

file(MAKE_DIRECTORY "${XML_OUTPUT}")
file(GLOB _standard_definitions "${DEFINITIONS_SOURCE}/mavlink/message_definitions/v1.0/*.xml")
file(COPY ${_standard_definitions} DESTINATION "${XML_OUTPUT}")
file(READ "${XML_OUTPUT}/all.xml" _all_xml)

foreach(_dialect IN ITEMS sv_mavlink_dialect copilot_mavlink_dialect)
    configure_file("${DEFINITIONS_SOURCE}/${_dialect}.xml" "${XML_OUTPUT}/${_dialect}.xml" COPYONLY)
    if(NOT _all_xml MATCHES "<include>[ \t\r\n]*${_dialect}\\.xml[ \t\r\n]*</include>")
        string(FIND "${_all_xml}" "</include>" _last_include REVERSE)
        if(_last_include EQUAL -1)
            message(FATAL_ERROR "The pinned all.xml has no dialect includes")
        endif()
        math(EXPR _insert_at "${_last_include} + 10")
        string(SUBSTRING "${_all_xml}" 0 ${_insert_at} _prefix)
        string(SUBSTRING "${_all_xml}" ${_insert_at} -1 _suffix)
        set(_all_xml "${_prefix}\n  <include>${_dialect}.xml</include>${_suffix}")
    endif()
endforeach()

file(WRITE "${XML_OUTPUT}/all.xml" "${_all_xml}")
